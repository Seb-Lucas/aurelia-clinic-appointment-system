APP_NAME="Clinical Healthcare Appointment System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=storage/app.sqlite
DB_USERNAME=root
DB_PASSWORD=
DB_SEED_DEMO_DATA=true

SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_SAME_SITE=Lax

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Clinic System"

LOG_CHANNEL=stderr
